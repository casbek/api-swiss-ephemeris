# Copy to .env for local development. In production prefer the environment
# variables of the systemd unit: a variable already set in the environment
# always wins over this file.

# development | production
# Only affects defaults such as the log format, never calculation results.
APP_ENV=development

# Listen address. Keep it on loopback and put nginx in front; the service has
# no TLS of its own.
LISTEN_ADDR=127.0.0.1:8080

# Directory holding the .se1 ephemeris files.
EPHE_PATH=./ephe

# OS threads reserved for Swiss Ephemeris. One is enough for thousands of
# charts per second. Values above 1 are rejected on Windows, where the library
# is not thread safe.
SWE_WORKERS=1

# debug | info | warn | error
LOG_LEVEL=info

# json | text. Defaults to text in development and json in production.
# LOG_FORMAT=json

# Comma separated API keys. Leave empty to disable authentication entirely,
# which is convenient while developing.
API_KEYS=

# Comma separated origins allowed to call the API from a browser. Leave empty
# when only server side clients call the service, which is the usual case.
CORS_ORIGINS=

# Timeouts and limits.
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s
MAX_BODY_BYTES=1048576
